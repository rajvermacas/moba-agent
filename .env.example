# ===================================
# MOBA Agent Configuration
# ===================================

# Google Gemini API Key (Required)
# Get your key from: https://ai.google.dev/gemini-api/docs/api-key
GOOGLE_API_KEY=

# MCP Server Configuration
# Path to MCP servers configuration file
MCP_CONFIG_FILE=mcp_servers.json

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=./logs

# Agent Configuration
AGENT_MODEL=gemini-2.5-flash
AGENT_TEMPERATURE=0.1
AGENT_MAX_TOKENS=4096

# ===================================
# FastAPI Server Configuration
# ===================================

# Server Host and Port
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001

# CORS Configuration (for React frontend)
ALLOW_CORS=true

# Request Settings
REQUEST_TIMEOUT=120
MAX_TOKENS=2000
TEMPERATURE=0.7

# ===================================
# Notes
# ===================================
# 1. The GOOGLE_API_KEY is required for the MCPAgent to work
# 2. MCP servers are configured in mcp_servers.json file
# 3. The FastAPI server runs on port 8001 by default
# 4. All OpenRouter/LLM configuration has been removed as MCPAgent handles this