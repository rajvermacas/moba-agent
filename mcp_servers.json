{
  "mcp_servers": [
    {
      "name": "mherb_mcp_server",
      "transport": "sse",
      "url": "http://localhost:8000/sse",
      "enabled": true,
      "reconnect": {
        "enabled": true,
        "max_attempts": 5,
        "delay_ms": 1000
      }
    },
    {
      "name": "moba_mcp_server",
      "transport": "sse",
      "url": "http://localhost:8002/sse",
      "enabled": false,
      "reconnect": {
        "enabled": true,
        "max_attempts": 5,
        "delay_ms": 1000
      }
    },
    {
      "name": "filesystem_server",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem"],
      "enabled": false
    },
    {
      "name": "github_server",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      },
      "enabled": false
    },
    {
      "name": "fetch",
      "transport": "stdio",
      "command": "uvx" ,
      "args": ["mcp-server-fetch"],
      "enabled": false
    },
    {
      "name": "gitlb-mcp",
      "transport": "stdio",
      "command": "npx" ,
      "args": ["-y", "@zereight/mcp-gitlab"],
      "enabled": false,
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "",
        "GITLAB_API_URL": "https://gitlab.com/api/v4",
        "GITLAB_READ_ONLY_MODE": "false",
        "USE_GITLAB_WIKI": "false",
        "USE_MILESTONE": "false",
        "USE_PIPELINE": "false"
      }
    }
    
  ]
}